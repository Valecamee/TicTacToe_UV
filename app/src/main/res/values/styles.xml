<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema principal de tu app con estética cyberpunk -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:colorBackground">@color/cyberpunk_black</item>
        <item name="android:windowBackground">@color/cyberpunk_black</item>
    </style>

    <!-- Estilo global para botones del tablero -->
    <style name="CyberButton">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">100dp</item>
        <item name="android:backgroundTint">@color/cyberpunk_purple</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/cyberpunk_yellow</item>
        <item name="android:shadowColor">@color/cyberpunk_cyan</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">12</item>
        <item name="android:onClick">onCellClicked</item>
    </style>

    <!-- Estilo para diálogos con la misma estética -->
    <style name="CyberAlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:textColorPrimary">@color/cyberpunk_cyan</item>
        <item name="android:textColor">@color/cyberpunk_cyan</item>
        <item name="android:background">@color/cyberpunk_black</item>
        <item name="colorAccent">@color/cyberpunk_magenta</item>
    </style>

</resources>
