<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_app"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/selecciona_rol"
        android:textSize="18sp"
        android:layout_marginBottom="20dp"/>

    <RadioGroup
        android:id="@+id/radioGroupRol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp">

        <RadioButton
            android:id="@+id/radioButtonServidor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rol_servidor"
            android:checked="true"
            android:textSize="16sp"/>

        <RadioButton
            android:id="@+id/radioButtonCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rol_cliente"
            android:textSize="16sp"/>
    </RadioGroup>

    <Button
        android:id="@+id/buttonIniciar"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/boton_iniciar"
        android:enabled="false"
        android:onClick="iniciarPartida"/>

</LinearLayout>