<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cyberpunk_black"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Espaciador superior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Título principal con efecto glow -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titulo_app"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/cyberpunk_magenta"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:shadowColor="@color/cyberpunk_magenta"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="20"/>

    <!-- Subtítulo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/subtitulo"
        android:textSize="14sp"
        android:textColor="@color/cyberpunk_cyan"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:shadowColor="@color/cyberpunk_cyan"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"/>

    <!-- Espaciador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <!-- Título de la sección -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/selecciona_rol"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/cyberpunk_yellow"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:shadowColor="@color/cyberpunk_yellow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"/>

    <!-- Tarjeta de selección con borde neón -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:padding="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <RadioGroup
            android:id="@+id/radioGroupRol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioButtonServidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rol_servidor"
                android:checked="true"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="@color/cyberpunk_cyan"
                android:padding="12dp"/>

            <RadioButton
                android:id="@+id/radioButtonCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rol_cliente"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:buttonTint="@color/cyberpunk_cyan"
                android:padding="12dp"
                android:layout_marginTop="12dp"/>
        </RadioGroup>
    </LinearLayout>

    <!-- Espaciador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp"/>

    <!-- Botón Iniciar con estilo cyberpunk -->
    <Button
        android:id="@+id/buttonIniciar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/boton_iniciar"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/cyberpunk_cyan"
        android:fontFamily="monospace"
        android:backgroundTint="@color/cyberpunk_dark_purple"
        android:enabled="false"
        android:onClick="iniciarPartida"
        android:letterSpacing="0.15"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="8dp"/>

    <!-- Estado Bluetooth -->
    <TextView
        android:id="@+id/textBtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[BT: CHECKING...]"
        android:textSize="14sp"
        android:textColor="@color/cyberpunk_yellow"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:shadowColor="@color/cyberpunk_yellow"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="5"/>

    <!-- Espaciador inferior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Línea decorativa inferior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/cyberpunk_purple"
        android:layout_marginTop="16dp"/>

</LinearLayout>